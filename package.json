{
	"name": "@0xrsydn/pstack-pi",
	"version": "0.16.0",
	"description": "Pi-native port of pstack with rigorous workflows, exact role routing, and isolated subagents.",
	"type": "module",
	"license": "MIT",
	"author": {
		"name": "Lauren Tan (original pstack)",
		"url": "https://github.com/cursor/plugins/tree/main/pstack"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/0xrsydn/pstack-pi"
	},
	"scripts": {
		"check": "npm run typecheck && npm test",
		"test": "node --experimental-strip-types --test extensions/pstack/*.test.ts skills/automate-me/scripts/*.test.mjs",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"pi-package",
		"pstack",
		"poteto-mode",
		"workflow",
		"principles",
		"subagents"
	],
	"pi": {
		"extensions": [
			"./extensions/pstack/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"files": [
		"skills",
		"agents",
		"extensions",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"package.json"
	],
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": ">=1.1.0",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
